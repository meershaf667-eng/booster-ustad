# ── Booster Ustad environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env to git.
# Any section left blank runs in clearly-labeled DEMO mode.

# Server
PORT=3000
# Random long string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when serving behind HTTPS so cookies are Secure.
COOKIE_SECURE=0

# ── SMS / OTP (Twilio Verify) ──────────────────────────────────────────────
# Leave blank => DEMO mode (OTP is shown on screen, no SMS sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Facebook / Meta ─────────────────────────────────────────────────────────
# Leave blank => DEMO mode (mock Pages, clearly labeled).
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:3000/api/facebook/callback
# REQUIRED for "Facebook Login for Business" apps (new flow): the Login
# Configuration ID from Facebook Login for Business → Configurations.
# Leave blank ONLY if the app uses classic Facebook Login.
FB_CONFIG_ID=
# Public base URL of THIS server, needed so Meta can fetch photos for real publishing.
# Example: https://booster-ustad.onrender.com
MEDIA_PUBLIC_BASE_URL=

# ── OpenAI (AI Assistant) ───────────────────────────────────────────────────
# Leave blank => DEMO mode (templated sample captions + setup instructions).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
